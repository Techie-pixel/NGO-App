<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">

            <!-- Slightly darker gradient for better contrast -->
            <gradient
                android:startColor="#F1F9FF"
            android:endColor="#D0ECF9"
            android:angle="270" />

            <!-- Rounded corners -->
            <corners android:radius="24dp" />

            <!-- Visible but soft blue border -->
            <stroke
                android:color="#4FC3F7"
            android:width="2dp" />
        </shape>
    </item>
</layer-list>
