<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".contactus"
    android:orientation="vertical"
    android:background="@drawable/gradient1">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="30dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/img"
            android:contentDescription="NGO Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact Us"
            android:textColor="@color/colorPrimary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/welcome1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome, Guest"
            android:textColor="@color/colorPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="We'd love to hear from you"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Scroll Area -->
    <ScrollView
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Contact Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="20dp"
                android:elevation="4dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Get in Touch"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Address: Nagpur, India"
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 Mobile: 95189 06823"
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✉️ Email: adityabokde33@gmail.com"
                    android:textSize="15sp"
                    android:textColor="@color/black" />

            </LinearLayout>

            <!-- Query Form Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="24dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Submit Your Query"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/contactname"
                    android:hint="Enter your name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gradient2"
                    android:padding="14dp"
                    android:textColor="@color/black"
                    android:layout_marginBottom="14dp"
                    android:textColorHint="@color/colorTextHint" />

                <EditText
                    android:id="@+id/mobile"
                    android:hint="Enter your Mobile no"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gradient2"
                    android:padding="14dp"
                    android:inputType="number"
                    android:textColor="@color/black"
                    android:layout_marginBottom="14dp"
                    android:textColorHint="@color/colorTextHint" />

                <EditText
                    android:id="@+id/query"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:hint="Any other comments or suggestions..."
                    android:gravity="top"
                    android:background="@drawable/gradient2"
                    android:padding="14dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/colorTextHint"
                    android:inputType="textMultiLine"
                    android:layout_marginBottom="20dp" />

                <Button
                    android:id="@+id/buttoncontact"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Submit"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/gradient_button" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
