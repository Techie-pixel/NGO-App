<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/image_card_bg"
    android:padding="12dp"
    android:layout_marginBottom="16dp"
    android:layout_marginHorizontal="20dp"
    android:elevation="4dp">

    <ImageView
        android:id="@+id/userEventImage"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:scaleType="centerCrop"
        android:background="@drawable/image_rounded_bg" />

    <TextView
        android:id="@+id/userEventTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Event Title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/userEventDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Date"
        android:textSize="14sp"
        android:textColor="@color/colorTextSecondary"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/userEventDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Description"
        android:textSize="15sp"
        android:textColor="@color/black"
        android:layout_marginTop="4dp" />

</LinearLayout>
